#!/bin/bash
# deos-decisions add --origine X --texte "..." [--options JSON --reco "..." --nature action|doctrine|acquis]
#
# POURQUOI --nature (11/08) : le registre servait a TROIS usages sous un seul statut —
# file d execution, registre de doctrine, journal de faits accomplis. Sur 61 decisions
# "accordee", 12 etaient des regles permanentes sans etat terminal et 9 des faits deja
# accomplis. Le stock ne pouvait pas decroitre, et la metrique du Chief of Staff qui le
# compte etait ininterpretable. Tri fait le 11/08 : 61 -> 36.
#
#   action   (defaut) : une tache avec un etat terminal. Entre dans la file.
#   doctrine          : une regle permanente. Va dans config/doctrine_dh.md, PAS dans
#                       la file. Rien a executer, donc rien a compter.
#   acquis            : un fait deja accompli. Cree et clos dans le meme geste,
#                       --preuve obligatoire. Trace sans encombrer.
# deos-decisions status <id> <statut> --par <agent> [options selon le statut]
# deos-decisions list [statut]
#
# POURQUOI LA MATRICE DE DROITS (LOT-03, 17/08) : la regle precedente etait
# "seuls cos, ceo et sam changent un statut". Juste dans son principe — le
# controle croise empeche un agent de se declarer quitte — mais paralysante en
# pratique. Le Delivery a corrige une decision le 15/08 : elle est restee ouverte
# six jours, faute de quelqu'un pour enregistrer que c'etait fait. Le goulot
# n'etait pas le controle, c'etait d'avoir mis le controle sur le mauvais geste.
#
# La V2 separe PROPOSER de VALIDER. Une direction peut declarer son travail fini
# (propose_cloture, avec preuve obligatoire) ; elle ne peut toujours pas le
# valider (clos reste a cos, ceo, sam). Le controle croise est preserve, l'attente
# disparait.
#
#   propose_cloture  la direction porteuse, avec preuve
#   blocked, failed  la direction porteuse, avec blocker + next-action + next-owner
#   needs_decision   la direction porteuse, avec question — cree une entree liee
#   clos             cos, ceo (suppleance), sam — preuve obligatoire
#   obsolete         cos, ceo, sam — motif obligatoire
#   refusee          cos, ceo, sam
#   accordee         ceo, sam
#   attente_sam      ceo, sam
#   en_execution     la direction porteuse, ou cos/ceo/sam
#
# POURQUOI EN_EXECUTION EST OUVERT AUX DIRECTIONS (17/08) : la matrice initiale
# du lot l'avait omis, et le laisser a cos/ceo/sam recreait le goulot au premier
# pas — la boucle d'execution n'aurait pas pu demarrer une tache sans attendre le
# Chief of Staff. Le controle croise ne porte pas sur le demarrage, il porte sur
# la cloture.
#
# LA DIRECTION PORTEUSE, DEFINITION (arbitrage du 17/08) : celle nommee owner
# d'au moins une tache de la decision ; a defaut de tache, l'origine. L'ecart est
# SIGNALE, jamais refuse — durcir plus tard est trivial, debloquer un refus
# injustifie coute des jours. C'est la lecon du 15 aout. Le durcissement est
# prevu au LOT-04.
set -euo pipefail
esc() { printf "%s" "$1" | sed "s/'/''/g"; }

# Les directions d'execution, par opposition aux roles d'arbitrage (cos, ceo, sam).
# Liste alignee sur les scopes de bin/deos-state. growth y figure parce que
# SPEC §5 en fait une fonction active ; sa fiche est creee par LOT-07.
est_direction() {
  case "$1" in commercial|marketing|delivery|cs|legal|financier|growth) return 0;; *) return 1;; esac
}
CMD="${1:-}"; shift || true
case "$CMD" in
  add)
    ORIGINE=""; TEXTE=""; OPTIONS="null"; RECO=""; NATURE="action"; PREUVE=""
    while [ $# -gt 0 ]; do case "$1" in
      --origine) ORIGINE="$2"; shift 2;; --texte) TEXTE="$2"; shift 2;;
      --options) OPTIONS="$2"; shift 2;; --reco) RECO="$2"; shift 2;;
      --nature) NATURE="$2"; shift 2;; --preuve) PREUVE="$2"; shift 2;;
      *) shift;; esac; done
    case "$NATURE" in action|doctrine|acquis) ;; *) echo "REFUS: --nature attend action, doctrine ou acquis" >&2; exit 2;; esac
    [ -z "$ORIGINE" ] || [ -z "$TEXTE" ] && { echo "REFUS: --origine et --texte requis" >&2; exit 2; }
    # Doctrine : hors file. Une regle n a pas d etat terminal, elle n a rien a faire
    # dans un stock qui mesure du travail en attente.
    if [ "$NATURE" = "doctrine" ]; then
      D=$(date +%Y-%m-%d); F=/workspace/config/doctrine_dh.md
      NUM=$(grep -c "^### " "$F" 2>/dev/null || echo 0); NUM=$((NUM+1))
      { echo ""; echo "### DOC-$(date +%Y-%m%d)-$(printf %02d $NUM) — $D — $ORIGINE"; echo ""; echo "$TEXTE"; } >> "$F"
      echo "DOC-$(date +%Y-%m%d)-$(printf %02d $NUM) (doctrine — config/doctrine_dh.md, hors file)"
      exit 0
    fi
    # Fait acquis : clos sans preuve n a pas de sens, et la contrainte clos_avec_preuve
    # le refuserait de toute facon.
    if [ "$NATURE" = "acquis" ] && [ -z "$PREUVE" ]; then
      echo "REFUS: --nature acquis exige --preuve (contrainte clos_avec_preuve)" >&2; exit 2
    fi
    # Garde-fou pedagogique, non bloquant : si le texte ressemble a une regle ou a un
    # fait accompli, on le signale sans empecher. C est ce melange qui a produit
    # 21 entrees inclassables sur 61.
    if [ "$NATURE" = "action" ]; then
      case "$TEXTE" in
        *CLOS*|*CORRIGE*|*CORRIGÉ*|*REGENERE*|*RÉGÉNÉRÉ*|*RECTIFICATION*)
          echo "AVIS: ce texte decrit peut-etre un fait accompli — envisager --nature acquis --preuve" >&2;;
        *"REGLE "*|*"RÈGLE "*|*"PRECISION DE SAM"*|*"PRÉCISION DE SAM"*|*"CORRECTION DE SAM"*)
          echo "AVIS: ce texte enonce peut-etre une regle permanente — envisager --nature doctrine" >&2;;
      esac
    fi
    N=$(psql "$COMITE_DB_DSN" -tA -c "SELECT lpad((count(*)+1)::text, 2, '0') FROM decisions WHERE id LIKE 'DEC-' || to_char(now(),'YYYY-MMDD') || '%';")
    ID="DEC-$(date +%Y-%m%d)-$N"
    # Mode demonstration : si actif, la decision est marquee et sera purgee.
    DEMO=$(psql "$COMITE_DB_DSN" -tA -c "SELECT actif FROM mode_demo WHERE id=1" 2>/dev/null)
    # psql renvoie "t"/"f" : on convertit en litteral SQL.
    if [ "$DEMO" = "t" ]; then DEMO=true; else DEMO=false; fi
    psql "$COMITE_DB_DSN" -q -c "INSERT INTO decisions (id, origine, texte, options, recommandation, demo) VALUES ('$ID', '$(esc "$ORIGINE")', '$(esc "$TEXTE")', $([ "$OPTIONS" = "null" ] && echo NULL || echo "'$(esc "$OPTIONS")'::jsonb"), $([ -z "$RECO" ] && echo NULL || echo "'$(esc "$RECO")'"), $DEMO);"
    if [ "$NATURE" = "acquis" ]; then
      psql "$COMITE_DB_DSN" -q -c "UPDATE decisions SET statut='clos', preuve='$(esc "$PREUVE")'::jsonb WHERE id='$ID';"
      echo "$ID (acquis — cree et clos)"
    else
      echo "$ID"
    fi ;;
  status)
    ID="${1:-}"; STATUT="${2:-}"; shift 2 || true
    PAR=""; PREUVE=""; PORTE=""; MOTIF=""; QUESTION=""
    BLOCKER=""; NEXT_ACTION=""; NEXT_OWNER=""; ERREUR=""
    while [ $# -gt 0 ]; do case "$1" in
      --par) PAR="$2"; shift 2;; --preuve) PREUVE="$2"; shift 2;;
      --porte-sur) PORTE="$2"; shift 2;; --motif) MOTIF="$2"; shift 2;;
      --question) QUESTION="$2"; shift 2;; --blocker) BLOCKER="$2"; shift 2;;
      --next-action) NEXT_ACTION="$2"; shift 2;; --next-owner) NEXT_OWNER="$2"; shift 2;;
      --erreur) ERREUR="$2"; shift 2;; *) shift;; esac; done
    [ -z "$ID" ] || [ -z "$STATUT" ] || [ -z "$PAR" ] && { echo "REFUS: <id>, <statut> et --par requis" >&2; exit 2; }

    # La decision doit exister. Sans ce controle, un UPDATE sur un identifiant
    # errone ne touchait aucune ligne et le retour affichait quand meme "OK" :
    # une faute de frappe passait pour un changement de statut.
    EXISTE=$(psql "$COMITE_DB_DSN" -tA -c "SELECT count(*) FROM decisions WHERE id='$(esc "$ID")';")
    [ "$EXISTE" = "1" ] || { echo "REFUS: decision $ID inconnue" >&2; exit 2; }

    # Matrice de droits. Elle est le coeur du lot : voir l'en-tete du fichier.
    case "$STATUT" in
      propose_cloture|blocked|failed|needs_decision)
        est_direction "$PAR" || { echo "REFUS: $STATUT se pose par la direction porteuse, pas par $PAR" >&2; exit 2; } ;;
      clos)
        case "$PAR" in cos|ceo|sam) ;; *) echo "REFUS: clos reste reserve a cos/ceo/sam — une direction PROPOSE (propose_cloture), elle ne valide pas" >&2; exit 2;; esac ;;
      obsolete|refusee)
        case "$PAR" in cos|ceo|sam) ;; *) echo "REFUS: $STATUT se pose par cos/ceo/sam" >&2; exit 2;; esac ;;
      accordee|attente_sam)
        case "$PAR" in ceo|sam) ;; *) echo "REFUS: $STATUT se pose par ceo/sam" >&2; exit 2;; esac ;;
      en_execution)
        if ! est_direction "$PAR"; then
          case "$PAR" in cos|ceo|sam) ;; *) echo "REFUS: en_execution se pose par la direction porteuse ou cos/ceo/sam" >&2; exit 2;; esac
        fi ;;
      *) echo "REFUS: statut inconnu: $STATUT" >&2; exit 2 ;;
    esac

    # Exigences propres a chaque statut. L'outil refuse AVANT la base : la
    # contrainte decisions_blocage_avec_suite est le filet, pas le message d'erreur
    # qu'on veut faire lire a un agent.
    case "$STATUT" in
      clos)            [ -n "$PREUVE" ] || { echo "REFUS: cloture sans preuve (DH-COS-002)" >&2; exit 2; } ;;
      propose_cloture) [ -n "$PREUVE" ] || { echo "REFUS: propose_cloture exige --preuve — proposer sans preuve, c'est deplacer l'attente, pas la lever" >&2; exit 2; } ;;
      obsolete)        [ -n "$MOTIF" ]  || { echo "REFUS: obsolete exige --motif — sinon obsolete devient la sortie commode de ce qu'on ne veut pas arbitrer" >&2; exit 2; } ;;
      needs_decision)  [ -n "$QUESTION" ] || { echo "REFUS: needs_decision exige --question, en une phrase" >&2; exit 2; } ;;
      blocked|failed)
        [ -n "$BLOCKER" ] && [ -n "$NEXT_ACTION" ] && [ -n "$NEXT_OWNER" ] || {
          echo "REFUS: $STATUT exige --blocker, --next-action et --next-owner (I4)" >&2
          echo "       un blocage sans action suivante est invisible : il ne repart jamais" >&2; exit 2; } ;;
    esac

    # Avis non bloquant. Definition de la direction porteuse (arbitrage du 17/08) :
    # owner d'au moins une tache de la decision ; A DEFAUT DE TACHE, l'origine.
    # L'ordre compte — des qu'une tache existe, c'est elle qui designe le porteur,
    # et l'origine ne suffit plus. Une decision ouverte par le CEO et executee par
    # le Delivery a pour porteur le Delivery, pas le CEO.
    #
    # On signale, on ne refuse pas : durcir plus tard est trivial, debloquer un
    # refus injustifie coute des jours (15/08). Durcissement prevu au LOT-04.
    if est_direction "$PAR"; then
      PORTEUSE=$(psql "$COMITE_DB_DSN" -tA -c "SELECT CASE WHEN EXISTS (SELECT 1 FROM tasks t WHERE t.decision_id=d.id) THEN EXISTS (SELECT 1 FROM tasks t WHERE t.decision_id=d.id AND t.owner='$(esc "$PAR")') ELSE (d.origine='$(esc "$PAR")') END FROM decisions d WHERE d.id='$(esc "$ID")';" 2>/dev/null || echo "t")
      if [ "$PORTEUSE" = "f" ]; then
        echo "AVIS: $PAR n'est pas la direction porteuse de $ID (owner d'une tache, ou origine si aucune tache)" >&2
      fi
    fi

    SETP=""
    [ -n "$PORTE" ] && SETP="$SETP, porte_sur='$(esc "$PORTE")', validation_par='$(esc "$PAR")'"
    case "$STATUT" in
      clos)
        # La preuve est FUSIONNEE, pas remplacee. Un simple ecrasement effacait la
        # trace propose_par posee a l'etape precedente : le CoS validait, et on
        # perdait qui avait propose. Toute la chaine proposition -> validation
        # perdait son premier maillon au moment meme ou elle se refermait.
        SETP="$SETP, preuve=coalesce(preuve,'{}'::jsonb) || '$(esc "$PREUVE")'::jsonb || jsonb_build_object('valide_par','$(esc "$PAR")','valide_le',now()), validation_par='$(esc "$PAR")'" ;;
      propose_cloture)
        # Qui propose est trace DANS la preuve : le CoS qui validera doit savoir de
        # qui vient la proposition, et aucune colonne ne porte cette information.
        SETP="$SETP, preuve='$(esc "$PREUVE")'::jsonb || jsonb_build_object('propose_par','$(esc "$PAR")','propose_le',now())" ;;
      obsolete)
        # Le motif va dans sa propre colonne depuis LOT-02 (migration
        # 2026-08-17-v2-tasks-statut-motif.sql). Il etait auparavant range dans
        # porte_sur, qui designe ce sur quoi la decision porte : deux informations
        # dans une colonne, dont l'une devenait illisible sans deviner laquelle.
        SETP="$SETP, motif='$(esc "$MOTIF")', validation_par='$(esc "$PAR")'" ;;
      blocked)
        SETP="$SETP, blocker='$(esc "$BLOCKER")', next_action='$(esc "$NEXT_ACTION")', next_owner='$(esc "$NEXT_OWNER")'" ;;
      failed)
        SETP="$SETP, blocker='$(esc "$BLOCKER")', next_action='$(esc "$NEXT_ACTION")', next_owner='$(esc "$NEXT_OWNER")', attempt_count=attempt_count+1"
        [ -n "$ERREUR" ] && SETP="$SETP, last_error='$(esc "$ERREUR")'" ;;
    esac

    # Sortir de blocked/failed efface la suite. Sans cela une decision revenue en
    # propose_cloture continuait d'afficher "blocker: api muette" — un blocage
    # fantome, qu'un lecteur croit actif alors qu'il est resolu. attempt_count et
    # last_error sont CONSERVES : ce sont des faits passes, pas un etat courant.
    case "$STATUT" in
      blocked|failed) ;;
      *) SETP="$SETP, blocker=NULL, next_action=NULL, next_owner=NULL" ;;
    esac

    if [ "$STATUT" = "needs_decision" ]; then
      # L'entree liee et le changement de statut sont UNE transaction. Une decision
      # qui attend un arbitrage sans que la question soit posee a Sam serait une
      # attente que personne ne voit — exactement ce que le statut sert a eviter.
      DEMO=$(psql "$COMITE_DB_DSN" -tA -c "SELECT actif FROM mode_demo WHERE id=1" 2>/dev/null || echo "")
      if [ "$DEMO" = "t" ]; then DEMO=true; else DEMO=false; fi
      NOUVEL_ID=$(psql "$COMITE_DB_DSN" -q -tA -v ON_ERROR_STOP=1 <<SQL
BEGIN;
UPDATE decisions SET statut='needs_decision'$SETP WHERE id='$(esc "$ID")';
INSERT INTO decisions (id, origine, texte, statut, porte_sur, demo)
SELECT 'DEC-' || to_char(now(),'YYYY-MMDD') || '-' || lpad((count(*)+1)::text, 2, '0'),
       '$(esc "$PAR")',
       'Arbitrage demande sur $(esc "$ID") : $(esc "$QUESTION")',
       'attente_sam', '$(esc "$ID")', $DEMO
  FROM decisions WHERE id LIKE 'DEC-' || to_char(now(),'YYYY-MMDD') || '%'
RETURNING id;
COMMIT;
SQL
)
      echo "OK: $ID → needs_decision (par $PAR) — question posee a Sam : $NOUVEL_ID"
    else
      psql "$COMITE_DB_DSN" -q -v ON_ERROR_STOP=1 -c "UPDATE decisions SET statut='$(esc "$STATUT")'$SETP WHERE id='$(esc "$ID")';"
      echo "OK: $ID → $STATUT (par $PAR)"
    fi ;;
  list)
    F="${1:-}"; W=""; [ -n "$F" ] && W="WHERE statut='$(esc "$F")'"
    psql "$COMITE_DB_DSN" -c "SELECT id, statut, origine, left(texte,60) AS texte, date::date FROM decisions $W ORDER BY date DESC LIMIT 20;" ;;
  *) echo "usage: deos-decisions add|status|list ..." >&2; exit 1 ;;
esac
