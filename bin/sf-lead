#!/bin/bash
# Écrit un prospect dans Salesforce. Depuis l'hôte OU depuis le conteneur.
#
# POURQUOI CE SCRIPT (10/08) : le Commercial a signale ne pas pouvoir ecrire
# dans Salesforce — verification faite, le conteneur des directeurs n'a ni le
# binaire `sf` ni les identifiants. Ils sont sur l'hote. Plutot que d'installer
# Salesforce dans chaque conteneur et d'y copier les identifiants, on expose
# une route : le service web relaie vers l'hote.
#
# REGLE DE SAM, 10/08 : les contacts, suivis de contact et campagnes qui ne
# sont pas dans Salesforce N'EXISTENT PAS.
#
#   sf-lead '{"Company":"Schneider Electric","LastName":"—","Source_DH__c":"Salon"}'
set -uo pipefail
JSON="${1:?usage: sf-lead '<json des champs>'}"

# VALIDATION D ENTREE — ajoutee le 17/08.
# Le Commercial a appele `sf-lead --help` ce matin. Le script ne reconnaissait
# aucun drapeau et a depose le texte litteral « --help » dans la file, ou
# l hote l a trouve illisible quelques minutes plus tard. Rien n a atteint
# Salesforce, mais rien ne l en empechait non plus : le script acceptait
# n importe quoi.
case "$JSON" in
  -h|--help|-*)
    cat >&2 <<'AIDE'
usage : sf-lead '<json des champs>'

  Cree un lead dans l org Salesforce Production.
  L argument doit etre un objet JSON, pas un drapeau.

  exemple :
    sf-lead '{"Company":"Schneider Electric","LastName":"Martin","Source_DH__c":"Salon"}'

  champs usuels : Company, LastName, FirstName, Email, Phone,
                  Source_DH__c, Tier_Vise__c, Score_Qualification__c
AIDE
    exit 2 ;;
esac

# L argument DOIT etre un JSON valide et un objet — sinon on refuse avant de
# deposer quoi que ce soit dans la file.
if ! printf '%s' "$JSON" | python3 -c "
import json, sys
d = json.load(sys.stdin)
if not isinstance(d, dict):
    raise SystemExit('doit etre un objet JSON')
if not d:
    raise SystemExit('objet vide')
" 2>/dev/null; then
  echo "sf-lead : argument invalide — un objet JSON est attendu." >&2
  echo "          reçu : $(printf '%s' "$JSON" | head -c 60)" >&2
  exit 2
fi
# CORRECTIF 11/08 : ecrivait dans equipe-dev, une org que le code de la plateforme
# ne lit nulle part (0 reference dans le depot, contre 11 pour digital-humans-dev).
# Chaque lead cree y devenait invisible du backend, de Marcus et des tests E2E.
ORG="${SF_ORG:-Production}"

if command -v sf >/dev/null 2>&1; then
  # ── Depuis l'hôte : appel direct ──
  VALEURS=$(python3 -c "
import json, sys
d = json.loads(sys.argv[1])
print(' '.join(f'{k}={json.dumps(str(v))}' for k, v in d.items()))
" "$JSON")
  eval sf data create record --sobject Lead --values "\"$VALEURS\"" \
       --target-org "$ORG" --json
else
  # ── Depuis le conteneur : par une FILE, traitee sur l'hote ──
  #
  # CORRECTIF DU 14/08. La version precedente appelait
  # http://comite-web:8090/api/sf/lead — une route qui N'A JAMAIS EXISTE.
  # Le service web n'expose que des routes de lecture. Verifie ce jour a la
  # demande de Sam : le Commercial n'a pu creer AUCUN lead depuis le 11/08,
  # date a laquelle ce canal lui a ete ouvert. Il repondait {"detail":"Not Found"}.
  #
  # Ecrire la route n'aurait pas suffi : dh-comite-web est lui aussi un
  # conteneur, sans le binaire `sf`. On depose donc dans une file que l'hote
  # traite — ce qui a l'avantage de laisser une trace de chaque demande, et de
  # respecter le curseur du Commercial : il propose, un mecanisme execute.
  mkdir -p /workspace/file-salesforce
  H=$(date -u +%Y%m%d-%H%M%S)-$$
  printf '%s\n' "$JSON" > "/workspace/file-salesforce/$H.json"
  echo "{\"file\":\"$H\",\"etat\":\"depose\",\"note\":\"traite par l hote sous 5 min\"}"
fi
